      color: "$ink"
      align: [center, middle]
      wrap: false
      text: 定稿版 V1.0
  - elementId: title
    elementType: text
    bounds: [64, 96, 952, 76]
    content:
      fontSize: 56
      fontFamily: 汇文明朝体
      color: "$ink"
      wrap: false
      align: [left, middle]
      text: AI 时代个人五能力模型
  - elementId: subtitle
    elementType: text
    bounds: [64, 184, 952, 26]
    content:
      fontSize: 18
      color: "$dim"
      wrap: false
      align: [left, middle]
      text: 面向个人的规范性框架 · 公理化表述 · 可证伪、可推翻、可优化
  - elementId: div1
    elementType: shape
    bounds: [64, 238, 952, 1]
    shapeName: rect
    fill: {type: solid, color: "$line"}

  # ===== 01 前提 =====
