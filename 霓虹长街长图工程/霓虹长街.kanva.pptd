version: v2
title: 人话版长图样稿A·霓虹长街
size: [1080, 7280]
customFonts:
  - family: 站酷文艺体
    src: "https://statics.kimi.ai/neo-design-static/p-font/站酷文艺体.ttf"
  - family: 更纱黑体
