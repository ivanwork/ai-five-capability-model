    green: "#4DFFA6"
    violet: "#B78CFF"
    red: "#FF5A5A"
    slate: "#8FA3C8"
    paper: "#F5F1E8"
    dim: "#9AA3B5"
    body: "#D8DCE6"
pages:
  - pages/1_sample.page
  - pages/2_full.page
